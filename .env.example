# Backend only. Never put secrets in VITE_* variables.
# Copy to .env; restart the backend after edits.
APP_MODE=sample
HOST=127.0.0.1
PORT=4311
# Live mode requires both the open-model planner and Databricks analytics.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
# Computer actions use local Python and VS Code. Set absolute executable paths.
# Example: C:\path\to\Python\python.exe (exclude the WindowsApps Store alias).
PYTHON_BIN=
# Example: C:\Users\you\AppData\Local\Programs\Microsoft VS Code\Code.exe
VSCODE_BIN=
POWERPOINT_BIN=
EXCEL_BIN=
# Optional OpenAI-compatible chat-completions URL for a provisioned HF endpoint.
HF_ENDPOINT_URL=
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=insightos
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Fast, short replies. Streaming recognition uses Scribe v2 Realtime.
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
DATABASE_URL=
# For a hosted backend, set a strong passphrase and an explicit allowed origin.
SESSION_PASSPHRASE=
CLIENT_ORIGIN=http://127.0.0.1:5173
# Defaults to an ignored .local folder. Docker uses /app/.local with a volume.
LOCAL_DATA_DIR=
# Optional desktop production origin for your deployed backend/UI; HTTPS only.
# Leave empty for the integrated local desktop app. Ignored by dev mode.
INSIGHTOS_APP_URL=
# Optional cloud inference service (Vultr): keep desktop UI/actions on localhost.
# Put HF credentials on that server and match its SESSION_PASSPHRASE here.
INSIGHTOS_CLOUD_URL=
INSIGHTOS_CLOUD_PASSPHRASE=
# Optional live-check script inputs (not required by the application).
VOICE_SMOKE_FILE=
# Optional: setting a PNG path explicitly authorizes its upload for check:providers.
VISION_SMOKE_FILE=
DEPLOYMENT_URL=
# Deployment guide only: DNS name without scheme, used by Compose/Caddy.
INSIGHTOS_DOMAIN=
