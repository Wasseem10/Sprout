# Copy to deploy/.env.cloud on the owned host; never commit the real file.
# Keep the laptop's .env and all desktop executable paths off this server.
INSIGHTOS_DOMAIN=insight.example.com
CLIENT_ORIGIN=https://insight.example.com
SESSION_PASSPHRASE=
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct:scaleway
HF_VISION_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct:deepinfra
# Optional experimental route; keep review disabled until acceptance.
HF_WRITING_MODEL_ID=
HF_WRITING_REASONING_EFFORT=
HF_WRITING_REVIEW_ENABLED=false
HF_ENDPOINT_URL=https://router.huggingface.co/v1/chat/completions
# Sample only governs the optional CSV dashboard. /api/agent/infer always calls
# the configured live HF models and returns actual cloud-service provenance.
APP_MODE=sample
# Optional hosted storage; leave empty for remote-inference-only deployment.
DATABASE_URL=
