{
  "name": "insightos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A voice-first desktop buddy that plans and completes supported computer tasks.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,ui,desktop \"tsx watch server/start.ts\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4311/health && electron . --dev\"",
    "dev:web": "concurrently -k -n api,ui \"tsx watch server/start.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:public": "tsc --noEmit && vite build --mode public",
    "start": "electron .",
    "start:web": "node dist-server/server/start.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:providers": "tsx scripts/check-providers.ts",
    "check:cloud": "tsx scripts/check-cloud.ts",
    "test:goal": "tsx scripts/smoke-goal.ts",
    "test:energy": "tsx scripts/smoke-energy.ts",
    "test:finance": "tsx scripts/smoke-finance.ts",
    "test:bills": "tsx scripts/smoke-bills.ts",
    "seed:databricks": "tsx scripts/seed-databricks.ts",
    "setup:desktop": "node node_modules/electron/install.js",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:native-pointer": "node scripts/smoke-native-pointer.mjs",
    "test:computer": "node scripts/smoke-computer.mjs",
    "format": "prettier --write src shared server electron scripts tests *.ts *.json *.md data/*.json data/*.md deploy/*.md deploy/*.yaml",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.17.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.6",
    "@napi-rs/canvas": "^1.0.11",
    "@neondatabase/serverless": "^1.0.0",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "^2.0.3"
  }
}
